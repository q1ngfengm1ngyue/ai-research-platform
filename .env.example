# Optional API keys. Basic requests are attempted without keys.
NCBI_API_KEY=
OPENALEX_API_KEY=

# PostgreSQL used by Project and Paper persistence.
# Replace the example password in your local .env; never commit .env.
POSTGRES_DB=ai_research
POSTGRES_USER=ai_research
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://ai_research:change_me@127.0.0.1:5432/ai_research

# Browser-visible FastAPI URL used by the Next.js frontend.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
